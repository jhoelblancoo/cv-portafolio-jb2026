{
  "name": "portfolio",
  "version": "0.0.4",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run build",
    "start": "node scripts/serve-static.mjs 4317",
    "start:dev": "ng serve --port 4317 --configuration development",
    "start:en": "ng serve --port 4317 --configuration en",
    "build": "ng build --configuration production && node scripts/seo-root.mjs",
    "seo:root": "node scripts/seo-root.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "i18n:extract": "ng extract-i18n --output-path src/locale --format xlf"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.5",
    "@netlify/angular-runtime": "^4.0.0",
    "express": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/localize": "^22.2.4",
    "@types/express": "^5.0.6",
    "@types/node": "^22.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
